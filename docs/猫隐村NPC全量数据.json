    "chats": {
      "洛克洛": "为了鲜血和荣誉!<br><table height=7 width=1 cellpadding=0 cellspacing=0><tr><td></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=/other/mystu.jsp target=_blank>查看我在线的学生</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=/other/listNewbie.jsp target=_blank>查找目前没有老师的新手</a></td></tr></table>",
      "封印师": "【解除封印】 在我这里使用[封印之蛋]即可<table height=7 width=1 cellpadding=0 cellspacing=0><tr><td></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"p.closeRenPic();return false;\">离开</a></td></tr></table><br>",
      "守护灵媒": "你好，我是守护灵媒，我可以帮助你获得自己的守护灵。<br><table height=7 width=1 cellpadding=0 cellspacing=0><tr><td></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/task2.gif></td><td width=5></td><td><a href=# onclick=\"p.cmd('taskTalk 2498947 pettask.maoyin.BuZhuoShiYan 0,1,');p.closeRenPic();return false;\">捕捉试验</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href='http://www.pet.imop.com/html/6/8/7849.htm' target=_blank>什么是守护灵？</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('listP');return false;\">购买守护灵相关的道具。</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('jianding look');return false;\">鉴定一个守护灵晶。</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('jianding all');return false;\">鉴定所有的守护灵晶。</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('kuorongshls');return false;\">增加一个守护灵栏位。</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('whichcanfeny');return false;\">都有哪些怪物可以封印做守护灵呢?</a></td></tr></table>",
      "物化灵媒": "你好，我是物化灵媒，我可以把你的守护灵物化成灵珠和龙珠，龙珠用来提升武器属性，灵珠提升防具属性。<br><table height=7 width=1 cellpadding=0 cellspacing=0><tr><td></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href='http://www.pet.imop.com/html/6/8/11283.htm' target=_blank>物化宠物详细介绍</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('shengjidan 灵丹');return false;\">灵丹升级</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('shengjidan 龙丹青');return false;\">龙丹【青】升级</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('shengjidan 龙丹红');return false;\">龙丹【红】升级</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('shengjizhu 灵珠');return false;\">灵珠升级</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('shengjizhu 龙珠青');return false;\">龙珠【青】升级</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('shengjizhu 龙珠红');return false;\">龙珠【红】升级</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"p.closeRenPic();return false;\">再见我还有别的事情要做。</a></td></tr></table>",
      "守护灵保姆": "我很会照顾守护灵哟！<br><table height=7 width=1 cellpadding=0 cellspacing=0><tr><td></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/task1.gif></td><td width=5></td><td><a href=# onclick=\"p.cmd('taskTalk 2498949 pettask.daily.MianFeiWeiShiSHL 0,');p.closeRenPic();return false;\">进行今天的免费喂食</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/task1.gif></td><td width=5></td><td><a href=# onclick=\"p.cmd('taskTalk 2498949 pettask.maoyin.ZengSongYiWangItem 0,1,');p.closeRenPic();return false;\">赠送技能遗忘道具</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('jiandingshl select');return false;\">鉴定天生技能</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('tuoguanshl select');return false;\">请帮我照顾我的守护灵</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('aboutshltuoguan');return false;\">守护灵的托管费多少？</a></td></tr></table>",
      "克拉拉": "我是猫隐大陆的守护灵研究师，在这个大陆上就没人比我更了解守护灵了。嗬嗬嗬~~ 对守护灵你有什么问题想请~~教~~么<br><table height=7 width=1 cellpadding=0 cellspacing=0><tr><td></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('aboutbornskill');return false;\">什么是天生技能？</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('aboutrefreshbornskill');return false;\">如何获得天生技能？</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('aboutlingqi');return false;\">什么是灵气值？</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('aboutshljinghua');return false;\">什么是守护灵精华？</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('aboutlingqijinghua');return false;\">什么是守护灵的偏好？灵气精华又是什么？</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"cmd('aboutshlpianhao');return false;\">请问姐姐，什么是蓝色小药丸呢~？</a></td></tr></table><table border=0 cellspacing=0 cellpadding=0><tr><td valign=top><img src=img/button/talk.gif></td><td width=5></td><td><a href=# onclick=\"p.closeTaskTalk();return false;\">离开~</a></td></tr></table>"
